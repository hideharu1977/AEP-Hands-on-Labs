<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- This app collects no personal data and does not track users. -->

    <!-- Required: declare all "required reason" API categories used. -->
    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <!-- clock_gettime(CLOCK_MONOTONIC) used for Doom's game-loop timing -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategorySystemBootTime</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <!-- "35F9.1" = measure time on-device; data not sent off device -->
                <string>35F9.1</string>
            </array>
        </dict>
    </array>

    <key>NSPrivacyCollectedDataTypes</key>
    <array/>

    <key>NSPrivacyTracking</key>
    <false/>

    <key>NSPrivacyTrackingDomains</key>
    <array/>
</dict>
</plist>
